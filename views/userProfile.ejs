<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <title>
            <%= profileUser.fullName %>'s Profile
        </title>
</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/nav') %>

            <div class="container mt-5 mb-5">
                <div class="row g-4">
                    <!-- Sidebar: User Info -->
                    <div class="col-lg-4">
                        <div class="profile-header-card sticky-top" style="top: 2rem; z-index: 1;">
                            <img src="<%= profileUser.profileImageURL || '/images/default.png' %>"
                                alt="<%= profileUser.fullName %>" class="profile-avatar-lg"
                                onerror="this.src='/images/default.png'">

                            <h1 class="profile-name">
                                <%= profileUser.fullName %>
                            </h1>
                            <p class="text-secondary mb-4">
                                <%= profileUser.email %>
                            </p>

                            <% if (profileUser.bio) { %>
                                <p class="text-secondary fst-italic mb-4">"<%= profileUser.bio %>"</p>
                                <% } %>

                                    <% if (locals.user && locals.user._id.toString() !==profileUser._id.toString()) { %>
                                        <div class="d-flex gap-2 mb-4">
                                            <button id="followBtn"
                                                class="btn flex-grow-1 <%= isFollowing ? 'btn-outline-danger' : 'btn-primary' %>"
                                                onclick="toggleFollow('<%= profileUser._id %>')">
                                                <% if (isFollowing) { %>
                                                    <i data-lucide="user-minus" class="me-1 icon-sm"></i> Unfollow
                                                    <% } else { %>
                                                        <i data-lucide="user-plus" class="me-1 icon-sm"></i> Follow
                                                        <% } %>
                                            </button>
                                            <a href="/chat?user=<%= profileUser._id %>"
                                                class="btn btn-outline-primary flex-grow-1">
                                                <i data-lucide="message-square" class="me-1 icon-sm"></i> Message
                                            </a>
                                        </div>
                                        <% } %>

                                            <div class="profile-stats-grid">
                                                <a href="/social/followers/<%= profileUser._id %>" class="stat-box">
                                                    <span class="stat-value" id="followerCount">
                                                        <%= profileUser.followers.length %>
                                                    </span>
                                                    <span class="stat-label">Followers</span>
                                                </a>
                                                <a href="/social/following/<%= profileUser._id %>" class="stat-box">
                                                    <span class="stat-value">
                                                        <%= profileUser.following.length %>
                                                    </span>
                                                    <span class="stat-label">Following</span>
                                                </a>
                                            </div>
                        </div>
                    </div>

                    <!-- Main Content -->
                    <div class="col-lg-8">
                        <!-- Tabs -->
                        <ul class="nav nav-tabs nav-tabs-profile" id="profileTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="blogs-tab" data-bs-toggle="tab"
                                    data-bs-target="#blogs" type="button" role="tab">
                                    <i data-lucide="feather" class="me-2 icon-sm"></i> Blogs
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="followers-tab" data-bs-toggle="tab"
                                    data-bs-target="#followers" type="button" role="tab">
                                    <i data-lucide="users" class="me-2 icon-sm"></i> Followers
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="following-tab" data-bs-toggle="tab"
                                    data-bs-target="#following" type="button" role="tab">
                                    <i data-lucide="users" class="me-2 icon-sm"></i> Following
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content" id="profileTabsContent">
                            <!-- Blogs Tab -->
                            <div class="tab-pane fade show active" id="blogs" role="tabpanel">
                                <% if (userBlogs && userBlogs.length> 0) { %>
                                    <div class="row g-4">
                                        <% userBlogs.forEach(blog=> { %>
                                            <div class="col-md-6">
                                                <div class="card h-100 shadow-sm border-0">
                                                    <img src="<%= blog.coverImageURL %>" class="card-img-top"
                                                        alt="<%= blog.title %>"
                                                        style="height: 180px; object-fit: cover;">
                                                    <div class="card-body">
                                                        <h5 class="card-title fw-bold text-truncate">
                                                            <%= blog.title %>
                                                        </h5>
                                                        <p class="card-text text-secondary text-truncate-3 small">
                                                            <%= blog.body.replace(/<[^>]*>/g, '').substring(0, 100)
                                                                %>...
                                                        </p>
                                                    </div>
                                                    <div class="card-footer bg-white border-top-0">
                                                        <a href="/blog/<%= blog._id %>"
                                                            class="btn btn-sm btn-outline-primary w-100">
                                                            <i data-lucide="book-open" class="me-1 icon-sm"></i> Read
                                                            Article
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }) %>
                                    </div>
                                    <% } else { %>
                                        <div class="text-center py-5">
                                            <i data-lucide="feather" class="mb-3 opacity-25"
                                                style="width: 48px; height: 48px;"></i>
                                            <h5 class="text-secondary">No stories yet</h5>
                                        </div>
                                        <% } %>
                            </div>

                            <!-- Followers Tab -->
                            <div class="tab-pane fade" id="followers" role="tabpanel">
                                <% if (profileUser.followers.length> 0) { %>
                                    <div class="row g-3">
                                        <% profileUser.followers.forEach(follower=> { %>
                                            <div class="col-md-6">
                                                <a href="/social/user/<%= follower._id %>" class="text-decoration-none">
                                                    <div class="user-card-sm">
                                                        <img src="<%= follower.profileImageURL %>"
                                                            class="user-avatar-sm" alt="<%= follower.fullName %>">
                                                        <div>
                                                            <h6 class="mb-0 text-primary">
                                                                <%= follower.fullName %>
                                                            </h6>
                                                            <small class="text-secondary">View Profile</small>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                            <% }) %>
                                    </div>
                                    <% } else { %>
                                        <div class="text-center py-5">
                                            <p class="text-secondary">No followers yet.</p>
                                        </div>
                                        <% } %>
                            </div>

                            <!-- Following Tab -->
                            <div class="tab-pane fade" id="following" role="tabpanel">
                                <% if (profileUser.following.length> 0) { %>
                                    <div class="row g-3">
                                        <% profileUser.following.forEach(followee=> { %>
                                            <div class="col-md-6">
                                                <a href="/social/user/<%= followee._id %>" class="text-decoration-none">
                                                    <div class="user-card-sm">
                                                        <img src="<%= followee.profileImageURL %>"
                                                            class="user-avatar-sm" alt="<%= followee.fullName %>">
                                                        <div>
                                                            <h6 class="mb-0 text-primary">
                                                                <%= followee.fullName %>
                                                            </h6>
                                                            <small class="text-secondary">View Profile</small>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                            <% }) %>
                                    </div>
                                    <% } else { %>
                                        <div class="text-center py-5">
                                            <p class="text-secondary">Not following anyone yet.</p>
                                        </div>
                                        <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('partials/footer') %>
                <%- include('partials/scripts') %>

                    <script>
                        async function toggleFollow(userId) {
                            try {
                                const followBtn = document.getElementById('followBtn');
                                const response = await fetch(`/social/follow/${userId}`, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' }
                                });

                                const data = await response.json();

                                if (data.success) {
                                    const followerCountElement = document.getElementById('followerCount');
                                    let count = parseInt(followerCountElement.innerText);

                                    if (data.following) {
                                        followBtn.classList.remove('btn-primary');
                                        followBtn.classList.add('btn-outline-danger');
                                        followBtn.innerHTML = '<i data-lucide="user-minus" class="me-1 icon-sm"></i> Unfollow';
                                        followerCountElement.innerText = count + 1;
                                    } else {
                                        followBtn.classList.remove('btn-outline-danger');
                                        followBtn.classList.add('btn-primary');
                                        followBtn.innerHTML = '<i data-lucide="user-plus" class="me-1 icon-sm"></i> Follow';
                                        followerCountElement.innerText = count - 1;
                                    }
                                    if (typeof lucide !== 'undefined') lucide.createIcons();
                                }
                            } catch (error) {
                                console.error('Error:', error);
                            }
                        }
                    </script>
</body>

</html>