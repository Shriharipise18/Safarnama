<!DOCTYPE html>
<html lang="en" class="add-blog-page">

<head>
    <%- include('partials/head') %>
        <title>Create New Blog</title>
        <!-- TinyMCE Script -->

        <script src="https://cdn.tiny.cloud/1/34zhin37w93jjpzlgtn8cmwutl1pdyig1c8anvddr4qs8kvm/tinymce/6/tinymce.min.js"
            referrerpolicy="origin"></script>
        <script>
            tinymce.init({
                selector: '#blogBody', // ID of the textarea to replace
                plugins: 'image code link lists video media', // Add plugins for images, links, lists, etc.
                toolbar: 'undo redo | styles | bold italic | alignleft aligncenter alignright | bullist numlist | link image media | code', // Customize toolbar
                height: 400, // Set editor height
                images_upload_url: '/upload-image', // Endpoint for image uploads
                images_upload_handler: function (blobInfo, success, failure) {
                    // Handle image uploads
                    const formData = new FormData();
                    formData.append('file', blobInfo.blob(), blobInfo.filename());

                    fetch('/upload-image', {
                        method: 'POST',
                        body: formData,
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.location) {
                                success(data.location); // Return the image URL
                            } else {
                                failure('Upload failed');
                            }
                        })
                        .catch(() => failure('Upload failed'));
                },
                media_live_embeds: true,
                video_template_callback: function (data) {
                    return '<video width="' + data.width + '" height="' + data.height +
                        '" controls="controls">\n' + '<source src="' + data.source +
                        '" type="' + data.sourcemime + '" />\n' + '</video>';
                }
            });
        </script>
        <style>
            #mediaFilesContainer {
                margin-top: 20px;
                max-height: 300px;
                overflow-y: auto;
            }

            .media-preview {
                display: flex;
                margin-bottom: 10px;
                padding: 10px;
                border: 1px solid var(--border-color, #ddd);
                border-radius: 4px;
                align-items: center;
                background-color: var(--surface-color, #f9f9f9);
                color: var(--text-primary);
            }

            .media-preview img {
                max-width: 100px;
                max-height: 100px;
                margin-right: 10px;
            }

            .media-preview .media-info {
                flex-grow: 1;
            }

            .media-preview .media-remove {
                margin-left: 10px;
            }

            .media-type-badge {
                display: inline-block;
                padding: 3px 8px;
                border-radius: 12px;
                font-size: 12px;
                font-weight: bold;
                margin-right: 10px;
            }

            .media-type-image {
                background-color: #28a745;
                color: white;
            }

            .media-type-video {
                background-color: #dc3545;
                color: white;
            }

            .media-type-audio {
                background-color: #007bff;
                color: white;
            }

            .media-type-document {
                background-color: #6c757d;
                color: white;
            }

            .media-type-other {
                background-color: #17a2b8;
                color: white;
            }

            /* Template styles */
            .template-section {
                background: rgba(79, 70, 229, 0.03);
                /* subtle primary tint */
                border-radius: 15px;
                padding: 20px;
                margin-bottom: 30px;
                border: 1px dashed var(--border-color, #e5e7eb);
                color: var(--text-primary);
            }

            .template-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
                gap: 15px;
                margin-top: 15px;
            }

            .template-card {
                background: var(--surface-color, #fff);
                border: 1px solid var(--border-color, #e5e7eb);
                border-radius: 10px;
                padding: 15px;
                text-align: center;
                cursor: pointer;
                transition: all 0.2s ease;
                color: var(--text-primary);
            }

            .template-card:hover {
                border-color: var(--primary);
                transform: translateY(-3px);
                box-shadow: var(--shadow-sm);
            }

            .template-card i {
                font-size: 1.5rem;
                margin-bottom: 8px;
                color: var(--primary);
            }

            .template-card span {
                display: block;
                font-size: 0.85rem;
                font-weight: 600;
            }
        </style>
</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/nav') %>
            <div class="container mt-4 mb-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2><i data-lucide="edit-3" class="me-2 icon-md"></i>Create New Blog</h2>
                    <a href="/profile" class="btn btn-sm btn-outline-secondary">Cancel</a>
                </div>

                <!-- Template Selection Section -->
                <div class="template-section">
                    <h6 class="mb-0"><i data-lucide="sparkles" class="me-2 icon-md"></i>Choose a Content Template</h6>
                    <p class="text-muted small mb-3">Starting with a template can help you structure your story better.
                    </p>
                    <div class="template-grid">
                        <div class="template-card" onclick="applyTemplate('adventure')">
                            <i data-lucide="mountain"></i>
                            <span>Adventure Story</span>
                        </div>
                        <div class="template-card" onclick="applyTemplate('review')">
                            <i data-lucide="star"></i>
                            <span>Product Review</span>
                        </div>
                        <div class="template-card" onclick="applyTemplate('guide')">
                            <i data-lucide="list-ordered"></i>
                            <span>How-to Guide</span>
                        </div>
                        <div class="template-card" onclick="applyTemplate('minimal')">
                            <i data-lucide="align-left"></i>
                            <span>Minimal Post</span>
                        </div>
                        <div class="template-card" onclick="applyTemplate('fitness')">
                            <i data-lucide="dumbbell"></i>
                            <span>Fitness Plan</span>
                        </div>
                        <div class="template-card" onclick="applyTemplate('tech')">
                            <i data-lucide="laptop"></i>
                            <span>Tech Tutorial</span>
                        </div>
                        <div class="template-card" onclick="applyTemplate('food')">
                            <i data-lucide="utensils"></i>
                            <span>Recipe</span>
                        </div>
                        <div class="template-card" onclick="applyTemplate('news')">
                            <i data-lucide="newspaper"></i>
                            <span>News Update</span>
                        </div>
                    </div>
                </div>

                <form action="/blog" method="post" enctype="multipart/form-data" id="blogForm">
                    <div class="mb-3">
                        <label for="title" class="form-label">Blog Title</label>
                        <input type="text" class="form-control" id="title" name="title" required>
                    </div>
                    <div class="mb-3">
                        <label for="category" class="form-label">Category</label>
                        <select class="form-select" id="category" name="category" required>
                            <option value="Technology">Technology</option>
                            <option value="Travel">Travel</option>
                            <option value="Food">Food</option>
                            <option value="Lifestyle">Lifestyle</option>
                            <option value="Fashion">Fashion</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="coverImage" class="form-label">Cover Image</label>
                        <input type="file" class="form-control" id="coverImage" name="coverImage" accept="image/*">
                    </div>

                    <!-- Media Files Upload Section -->
                    <div class="mb-3">
                        <label class="form-label">Media Files (Images, Videos, Documents, etc.)</label>
                        <div class="input-group">
                            <input type="file" class="form-control" id="mediaFileInput" multiple>
                            <button class="btn btn-outline-secondary" type="button" id="uploadMediaBtn">Upload</button>
                        </div>
                        <small class="text-muted">Supported types: Images, Videos, Audio, PDF, Documents, etc. Max size:
                            50MB per file.</small>
                        <div id="mediaFilesContainer"></div>
                        <!-- Hidden input to store uploaded media files data -->
                        <input type="hidden" id="mediaFilesData" name="mediaFiles">
                    </div>


                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label for="blogBody" class="form-label mb-0">Blog Content</label>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal"
                                data-bs-target="#aiModal">
                                <i data-lucide="bot" class="me-1 icon-sm"></i> Auto Write with AI
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success ms-2" id="btnReviewAI">
                                <i data-lucide="check-check" class="me-1 icon-sm"></i> AI Review
                            </button>
                        </div>
                        <textarea id="blogBody" name="body" class="form-control"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </form>
            </div>

            <!-- AI Generation Modal -->
            <div class="modal fade" id="aiModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i data-lucide="sparkles" class="me-2 icon-md"></i>Auto Write Blog
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <ul class="nav nav-tabs mb-3" id="aiTabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="topic-tab" data-bs-toggle="tab"
                                        data-bs-target="#topic" type="button" role="tab">Topic</button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="pdf-tab" data-bs-toggle="tab" data-bs-target="#pdf"
                                        type="button" role="tab">PDF File</button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link" id="link-tab" data-bs-toggle="tab" data-bs-target="#link"
                                        type="button" role="tab">Web Link</button>
                                </li>
                            </ul>
                            <div class="tab-content" id="aiTabContent">
                                <!-- Topic Tab -->
                                <div class="tab-pane fade show active" id="topic" role="tabpanel">
                                    <div class="mb-3">
                                        <label class="form-label">Enter Topic or Title</label>
                                        <textarea class="form-control" id="aiTopicInput" rows="3"
                                            placeholder="e.g., A 3-day itinerary for a trip to Goa..."></textarea>
                                    </div>
                                </div>
                                <!-- PDF Tab -->
                                <div class="tab-pane fade" id="pdf" role="tabpanel">
                                    <div class="mb-3">
                                        <label class="form-label">Upload a PDF document</label>
                                        <input type="file" class="form-control" id="aiPdfInput"
                                            accept="application/pdf">
                                        <small class="text-muted">The AI will read the PDF and write a blog about
                                            it.</small>
                                    </div>
                                </div>
                                <!-- Link Tab -->
                                <div class="tab-pane fade" id="link" role="tabpanel">
                                    <div class="mb-3">
                                        <label class="form-label">Paste a Web Link</label>
                                        <input type="url" class="form-control" id="aiLinkInput"
                                            placeholder="https://example.com/article">
                                        <small class="text-muted">The AI will read the webpage and summarize/rewrite
                                            it.</small>
                                    </div>
                                </div>
                            </div>
                            <div id="aiError" class="alert alert-danger d-none mt-2"></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="button" class="btn btn-primary" id="btnGenerate">Generate Blog</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- AI Review Modal -->
            <div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title"><i data-lucide="check-check" class="me-2 icon-md"></i>AI Content
                                Review</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-md-4 border-end">
                                    <h6 class="text-primary mb-3">AI Suggestions</h6>
                                    <ul id="reviewSuggestions" class="list-group list-group-flush small"
                                        style="max-height: 400px; overflow-y: auto;">
                                        <li class="list-group-item text-muted">Analyzing content...</li>
                                    </ul>
                                </div>
                                <div class="col-md-8">
                                    <h6 class="text-success mb-3">Corrected Content Preview</h6>
                                    <div id="reviewPreview" class="p-3 bg-light rounded border"
                                        style="max-height: 400px; overflow-y: auto; font-size: 0.9rem;">
                                        <!-- Corrected content will be loaded here -->
                                    </div>
                                </div>
                            </div>
                            <div id="reviewError" class="alert alert-danger d-none mt-3"></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="button" class="btn btn-success" id="btnApplyReview">Apply Corrections</button>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('partials/footer') %>
                <%- include('partials/scripts') %>

                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            const btnGenerate = document.getElementById('btnGenerate');
                            const aiError = document.getElementById('aiError');

                            btnGenerate.addEventListener('click', async function () {
                                // Determine active tab
                                const activeTab = document.querySelector('#aiTabs .active').id;
                                let type, content, file;

                                if (activeTab === 'topic-tab') {
                                    type = 'topic';
                                    content = document.getElementById('aiTopicInput').value;
                                    if (!content) return showError('Please enter a topic.');
                                } else if (activeTab === 'pdf-tab') {
                                    type = 'pdf';
                                    const fileInput = document.getElementById('aiPdfInput');
                                    if (fileInput.files.length === 0) return showError('Please select a PDF file.');
                                    file = fileInput.files[0];
                                } else if (activeTab === 'link-tab') {
                                    type = 'link';
                                    content = document.getElementById('aiLinkInput').value;
                                    if (!content) return showError('Please enter a link.');
                                }

                                // UI Loading State
                                btnGenerate.disabled = true;
                                btnGenerate.innerHTML = '<i data-lucide="loader-2" class="animate-spin me-2"></i> Generating...';
                                if (typeof lucide !== 'undefined') lucide.createIcons();
                                aiError.classList.add('d-none');

                                try {
                                    const formData = new FormData();
                                    formData.append('type', type);
                                    if (content) formData.append('content', content);
                                    if (file) formData.append('file', file);

                                    const response = await fetch('/blog/generate-ai', {
                                        method: 'POST',
                                        body: formData
                                    });

                                    const data = await response.json();

                                    if (data.success) {
                                        // Insert into TinyMCE
                                        tinymce.get('blogBody').setContent(data.content);

                                        // Close Modal
                                        const modalEl = document.getElementById('aiModal');
                                        const modal = bootstrap.Modal.getInstance(modalEl);
                                        modal.hide();
                                    } else {
                                        showError(data.message || 'Failed to generate content.');
                                    }

                                } catch (error) {
                                    console.error(error);
                                    showError('An error occurred. Please try again.');
                                } finally {
                                    btnGenerate.disabled = false;
                                    btnGenerate.innerHTML = 'Generate Blog';
                                }
                            });

                            function showError(msg) {
                                aiError.textContent = msg;
                                aiError.classList.remove('d-none');
                            }


                            const mediaFiles = [];

                            const mediaFilesContainer = document.getElementById('mediaFilesContainer');
                            const mediaFilesDataInput = document.getElementById('mediaFilesData');

                            // Update hidden input with media files data
                            function updateMediaFilesData() {
                                mediaFilesDataInput.value = JSON.stringify(mediaFiles);
                            }

                            // Display uploaded media files
                            function renderMediaFiles() {
                                mediaFilesContainer.innerHTML = '';

                                if (mediaFiles.length === 0) {
                                    return;
                                }

                                mediaFiles.forEach((file, index) => {
                                    const mediaItem = document.createElement('div');
                                    mediaItem.className = 'media-preview';

                                    let previewHTML = '';
                                    if (file.type && file.type.startsWith('image/')) {
                                        previewHTML = `<img src="${file.url}" alt="${file.name}">`;
                                    } else if (file.type && file.type.startsWith('video/')) {
                                        previewHTML = `
                            <div style="width: 100px; height: 100px; position: relative; margin-right: 10px;">
                                <video width="100" height="100" style="object-fit: cover;">
                                    <source src="${file.url}" type="${file.type}">
                                </video>
                                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
                                    <i data-lucide="play-circle" class="icon-lg text-white"></i>
                                </div>
                            </div>
                        `;
                                    } else if (file.type && file.type.startsWith('audio/')) {
                                        previewHTML = `<i data-lucide="music" class="icon-lg me-2"></i>`;
                                    } else {
                                        previewHTML = `<i data-lucide="file-text" class="icon-lg me-2"></i>`;
                                    }

                                    mediaItem.innerHTML = `
                        ${previewHTML}
                        <div class="media-info">
                            <span class="media-type-badge">${file.type ? file.type.split('/')[0] : 'file'}</span>
                            <span class="fw-bold">${file.name}</span>
                            <div class="text-muted small">${formatFileSize(file.size)}</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger media-remove" data-index="${index}">
                            <i data-lucide="x" class="icon-sm"></i>
                        </button>
                    `;

                                    mediaFilesContainer.appendChild(mediaItem);
                                });

                                // Add event listeners to remove buttons
                                document.querySelectorAll('.media-remove').forEach(button => {
                                    button.addEventListener('click', function () {
                                        const index = parseInt(this.getAttribute('data-index'));
                                        mediaFiles.splice(index, 1);
                                        updateMediaFilesData();
                                        renderMediaFiles();
                                    });
                                });
                            }

                            // Handle media file upload
                            document.getElementById('uploadMediaBtn').addEventListener('click', function () {
                                const fileInput = document.getElementById('mediaFileInput');
                                const files = fileInput.files;

                                if (files.length === 0) {
                                    alert('Please select files to upload');
                                    return;
                                }

                                const formData = new FormData();
                                for (let i = 0; i < files.length; i++) {
                                    formData.append('mediaFiles', files[i]);
                                }

                                // Show loading indicator
                                this.innerHTML = '<i data-lucide="loader-2" class="animate-spin me-2"></i> Uploading...';
                                if (typeof lucide !== 'undefined') lucide.createIcons();
                                this.disabled = true;

                                fetch('/blog/upload-media', {
                                    method: 'POST',
                                    body: formData
                                })
                                    .then(response => response.json())
                                    .then(data => {
                                        if (data.success) {
                                            // Add uploaded files to our array
                                            data.files.forEach(file => {
                                                mediaFiles.push(file);
                                            });
                                            updateMediaFilesData();
                                            renderMediaFiles();
                                            fileInput.value = ''; // Clear the file input
                                        } else {
                                            alert('Error uploading files: ' + data.message);
                                        }
                                    })
                                    .catch(error => {
                                        console.error('Error:', error);
                                        alert('An error occurred while uploading files');
                                    })
                                    .finally(() => {
                                        // Reset button
                                        this.innerHTML = 'Upload';
                                        this.disabled = false;
                                    });
                            });

                            // Format file size to human-readable format
                            function formatFileSize(bytes) {
                                if (bytes === 0) return '0 Bytes';
                                const k = 1024;
                                const sizes = ['Bytes', 'KB', 'MB', 'GB'];
                                const i = Math.floor(Math.log(bytes) / Math.log(k));
                                return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
                            }

                            // Handle form submit
                            // AI Review Logic
                            const btnReviewAI = document.getElementById('btnReviewAI');
                            const reviewModalEl = document.getElementById('reviewModal');
                            const reviewModal = new bootstrap.Modal(reviewModalEl);
                            const reviewSuggestions = document.getElementById('reviewSuggestions');
                            const reviewPreview = document.getElementById('reviewPreview');
                            const btnApplyReview = document.getElementById('btnApplyReview');
                            const reviewError = document.getElementById('reviewError');

                            let correctedContent = '';

                            btnReviewAI.addEventListener('click', async function () {
                                const content = tinymce.get('blogBody').getContent();
                                if (!content || content.length < 10) {
                                    alert('Please write some content first to review.');
                                    return;
                                }

                                // Reset Modal
                                reviewSuggestions.innerHTML = '<li class="list-group-item text-muted"><i data-lucide="loader-2" class="animate-spin me-2"></i>Analyzing your content...</li>';
                                if (typeof lucide !== 'undefined') lucide.createIcons();
                                reviewPreview.innerHTML = '<div class="text-center py-5"><i data-lucide="loader-2" class="animate-spin icon-lg text-muted"></i></div>';
                                if (typeof lucide !== 'undefined') lucide.createIcons();
                                reviewError.classList.add('d-none');
                                btnApplyReview.disabled = true;

                                reviewModal.show();

                                try {
                                    const response = await fetch('/blog/review-content', {
                                        method: 'POST',
                                        headers: {
                                            'Content-Type': 'application/json'
                                        },
                                        body: JSON.stringify({ content })
                                    });

                                    const data = await response.json();

                                    if (data.success) {
                                        correctedContent = data.corrected;

                                        // Render Suggestions
                                        reviewSuggestions.innerHTML = '';
                                        if (data.suggestions && data.suggestions.length > 0) {
                                            data.suggestions.forEach(suggestion => {
                                                const li = document.createElement('li');
                                                li.className = 'list-group-item';
                                                li.innerHTML = `<i data-lucide="lightbulb" class="text-warning me-2 icon-sm"></i>${suggestion}`;
                                                reviewSuggestions.appendChild(li);
                                            });
                                        } else {
                                            reviewSuggestions.innerHTML = '<li class="list-group-item text-muted">No specific suggestions.</li>';
                                        }

                                        // Render Preview
                                        reviewPreview.innerHTML = correctedContent;
                                        btnApplyReview.disabled = false;

                                    } else {
                                        reviewError.textContent = data.message || 'Review failed.';
                                        reviewError.classList.remove('d-none');
                                    }
                                } catch (error) {
                                    console.error(error);
                                    reviewError.textContent = 'An error occurred during review.';
                                    reviewError.classList.remove('d-none');
                                }
                            });

                            btnApplyReview.addEventListener('click', function () {
                                if (correctedContent) {
                                    tinymce.get('blogBody').setContent(correctedContent);
                                    reviewModal.hide();
                                    alert('Corrections applied successfully!');
                                }
                            });

                            document.getElementById('blogForm').addEventListener('submit', function (e) {
                                updateMediaFilesData();
                            });
                        });

                        const templates = {
                            adventure: `
                                <h2>The Journey Begins</h2>
                                <p>Describe how your adventure started. What was the motivation? Where were you headed?</p>
                                <div style="background: rgba(79, 70, 229, 0.05); border-left: 4px solid #4f46e5; padding: 20px; font-style: italic; margin: 20px 0; border-radius: 4px;">
                                    "Adventure is worthwhile in itself." – Amelia Earhart
                                </div>
                                <h3>Visual Highlights</h3>
                                <p>[Insert your best adventure photo here]</p>
                                <h3>The Challenges</h3>
                                <p>What unexpected things happened? How did you overcome them?</p>
                                <h3>Conclusion</h3>
                                <p>What was the most memorable moment? Would you do it again?</p>
                            `,
                            review: `
                                <h2>Review: [Product/Place Name]</h2>
                                <p>A quick summary of what you are reviewing and your overall rating.</p>
                                <div style="background: rgba(79, 70, 229, 0.05); padding: 20px; border-radius: 10px; margin: 20px 0;">
                                    <h4>Pros & Cons</h4>
                                    <div style="display: flex; gap: 40px;">
                                        <div>
                                            <strong style="color: #28a745;">✓ Pros</strong>
                                            <ul>
                                                <li>Amazing feature 1</li>
                                                <li>Great value 2</li>
                                            </ul>
                                        </div>
                                        <div>
                                            <strong style="color: #dc3545;">✗ Cons</strong>
                                            <ul>
                                                <li>Expensive</li>
                                                <li>Requires learning curve</li>
                                            </ul>
                                        </div>
