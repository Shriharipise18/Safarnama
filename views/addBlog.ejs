                        function applyTemplate(type) {
                            const content = templates[type];
                            if (!content) return;

                            const existingContent = tinymce.get('blogBody').getContent();
                            if (existingContent && existingContent.length > 50 && existingContent !== '<p><br data-mce-bogus="1"></p>') {
                                if (!confirm('This will overwrite your existing blog content. Are you sure?')) {
                                    return;
                                }
                            }

                            tinymce.get('blogBody').setContent(content);
                            // Scroll to editor
                            window.scrollTo({
                                top: document.getElementById('blogBody').offsetTop - 100,
                                behavior: 'smooth'
                            });
                        }
                    </script>
