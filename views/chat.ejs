<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <title>Safarnama - Messages</title>
        <link rel="stylesheet" href="/css/styles.css">
        <style>
            /* Chat specific overrides for full page experience */
            body.chat-body {
                height: 100vh;
                overflow: hidden;
            }

            .chat-layout {
                display: flex;
                height: calc(100vh - 72px);
                /* Adjustment for navbar height */
                background: var(--bg-color);
                border-radius: 0;
                overflow: hidden;
                box-shadow: none;
                margin: 0;
                border: none !important;
            }

            .chat-sidebar {
                width: 350px;
                background: var(--surface-color);
                border-right: 1px solid var(--border-color);
                display: flex;
                flex-direction: column;
                transition: transform 0.3s ease;
            }

            .chat-main {
                flex-grow: 1;
                display: flex;
                flex-direction: column;
                background: var(--bg-color);
                transition: transform 0.3s ease;
            }

            .back-btn {
                display: none;
                background: none;
                border: none;
                color: var(--text-primary);
                padding: 0;
                margin-right: 10px;
                cursor: pointer;
            }

            @media (max-width: 768px) {
                .chat-sidebar {
                    width: 100%;
                    position: absolute;
                    top: 0;
                    bottom: 0;
                    left: 0;
                    z-index: 10;
                }

                .chat-main {
                    width: 100%;
                    position: absolute;
                    top: 0;
                    bottom: 0;
                    left: 0;
                    z-index: 5;
                    transform: translateX(100%);
                }

                .chat-layout.chat-open .chat-sidebar {
                    transform: translateX(-100%);
                }

                .chat-layout.chat-open .chat-main {
                    transform: translateX(0);
                    z-index: 15;
                }

                .back-btn {
                    display: block;
                }

                .chat-header {
                    padding: 10px 15px;
                }

                .messages-container {
                    padding: 15px;
                }

                .chat-footer {
                    padding: 10px;
                }

                .message-bubble {
                    max-width: 85%;
                }
            }

            .conversation-list {
                flex-grow: 1;
                overflow-y: auto;
            }

            .conversation-item {
                display: flex;
                padding: 15px;
                cursor: pointer;
                transition: all 0.2s;
                border-bottom: 1px solid var(--border-color);
                align-items: center;
                gap: 12px;
            }

            .conversation-item:hover {
                background: rgba(var(--primary-rgb), 0.05);
            }

            .conversation-item.active {
                background: rgba(var(--primary-rgb), 0.1);
                border-left: 4px solid var(--primary);
            }

            .avatar-container {
                position: relative;
            }

            .status-dot {
                position: absolute;
                bottom: 2px;
                right: 2px;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                border: 2px solid var(--surface-color);
                background: #cbd5e1;
                /* offline */
            }

            .status-dot.online {
                background: #22c55e;
            }

            .chat-header {
                padding: 15px 25px;
                background: var(--surface-color);
                border-bottom: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                gap: 15px;
            }

            .messages-container {
                flex-grow: 1;
                overflow-y: auto;
                padding: 25px;
                display: flex;
                flex-direction: column;
                gap: 15px;
            }

            .message-bubble {
                max-width: 70%;
                padding: 10px 15px;
                border-radius: var(--radius-md);
                position: relative;
                font-size: 0.95rem;
            }

            .message-sent {
                align-self: flex-end;
                background: var(--primary);
                color: white;
                border-bottom-right-radius: 2px;
            }

            .message-received {
                align-self: flex-start;
                background: var(--surface-color);
                color: var(--text-primary);
                border-bottom-left-radius: 2px;
                box-shadow: var(--shadow-sm);
            }

            .chat-footer {
                padding: 20px;
                background: var(--surface-color);
                border-top: 1px solid var(--border-color);
            }

            .message-form {
                display: flex;
                gap: 10px;
            }

            .message-input {
                flex-grow: 1;
                border-radius: var(--radius-full);
                padding: 10px 20px;
                border: 1px solid var(--border-color);
                background: var(--bg-color);
                color: var(--text-primary);
            }

            .message-input:focus {
                outline: none;
                border-color: var(--primary);
            }

            .no-chat-selected {
                height: 100%;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                color: var(--text-tertiary);
                text-align: center;
                padding: 40px;
            }

            .typing-indicator {
                font-size: 0.8rem;
                color: var(--text-secondary);
                padding: 5px 25px;
                font-style: italic;
            }
        </style>
</head>

<body class="chat-body">
    <%- include('partials/header') %>
        <%- include('partials/nav') %>

            <script>
                window.currentUserId = '<%= user._id %>';
            </script>

            <div class="chat-layout border-top">
                <!-- Sidebar -->
                <div class="chat-sidebar">
                    <div class="chat-header">
                        <h5 class="mb-0 d-flex align-items-center"><i data-lucide="message-square"
                                class="me-2"></i>Chats</h5>
                    </div>
                    <div class="conversation-list" id="conversationList">
                        <!-- Conversations will be loaded via JS -->
                        <div class="text-center p-4">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        </div>
                    </div>
                </div>

                <!-- Main Chat Area -->
                <div class="chat-main" id="chatWindow">
                    <div class="no-chat-selected">
                        <div class="icon-circle mb-4">
                            <i data-lucide="messages-square" style="width: 48px; height: 48px;"></i>
                        </div>
                        <h4>Select a conversation</h4>
                        <p class="text-secondary">Get in touch with other travelers and bloggers.</p>
                    </div>
                </div>
            </div>

            <!-- Message Templates (Hidden) -->
            <template id="messageTemplate">
                <div class="message-bubble">
                    <span class="content"></span>
                    <div class="text-end mt-1">
                        <small class="time opacity-75" style="font-size: 0.7rem;"></small>
                    </div>
                </div>
            </template>

            <template id="chatHeaderTemplate">
                <div class="chat-header">
                    <img src="" alt="" class="profile-img-sm" style="width: 40px; height: 40px;">
                    <div>
                        <h6 class="mb-0 name"></h6>
                        <small class="text-success presence-status"></small>
                    </div>
                </div>
            </template>

            <template id="chatInputTemplate">
                <div id="typingIndicator" class="typing-indicator" style="display: none;">Someone is typing...</div>
                <div class="chat-footer">
                    <form class="message-form" id="messageForm">
                        <input type="file" id="imageInput" accept="image/*" style="display: none;">
                        <button type="button" class="chat-action-btn attach-btn" id="attachBtn" title="Attach image">
                            <i data-lucide="paperclip"></i>
                        </button>
                        <input type="text" class="message-input" id="messageInput" placeholder="Type a message..."
                            autocomplete="off">
                        <button type="submit" class="chat-action-btn send-btn" id="sendBtn">
                            <i data-lucide="send"></i>
                        </button>
                    </form>
                </div>
            </template>

            <%- include('partials/scripts') %>


                <!-- Load Socket.io Client -->
                <script src="/socket.io/socket.io.js"></script>
                <script src="/js/chat.js"></script>
</body>

</html>