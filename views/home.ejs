<!DOCTYPE html>
<html lang="en" class="home-page">

<head>
    <%- include('partials/head') %>
        <title>Homepage</title>
</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/nav') %>

            <div class="hero-section text-center py-5 d-flex align-items-center position-relative overflow-hidden"
                style="background: linear-gradient(135deg, var(--primary), var(--primary-hover)); color: white; border-radius: 0 0 var(--radius-lg) var(--radius-lg); margin-top: -1rem; min-height: 550px;">
                <!-- Decorative Elements -->
                <div class="position-absolute translate-middle"
                    style="top: 20%; left: 10%; width: 300px; height: 300px; background: rgba(255,255,255,0.1); border-radius: 50%; filter: blur(80px);">
                </div>
                <div class="position-absolute translate-middle"
                    style="bottom: 0%; right: 0%; width: 250px; height: 250px; background: rgba(255,255,255,0.15); border-radius: 50%; filter: blur(60px);">
                </div>

                <div class="container py-lg-5 position-relative z-1 animate-fade-up">
                    <h1 class="display-1 fw-bold mb-3 tracking-tight">Your Journey, <span class="text-white-50">Your
                            Story.</span></h1>
                    <p class="lead mb-5 mx-auto opacity-75"
                        style="max-width: 800px; font-weight: 400; font-size: 1.4rem;">
                        Join a global community of travelers sharing authentic experiences, capturing memories,
                        and discovering the world's hidden gems.
                    </p>
                    <div class="d-flex gap-3 justify-content-center">
                        <% if (!locals.user) { %>
                            <a href="/user/signup"
                                class="btn btn-light btn-lg px-5 py-3 fw-bold rounded-pill shadow-lg transition-all"
                                style="color: var(--primary);">Start Your Adventure</a>
                            <% } else { %>
                                <a href="/blog/add-new"
                                    class="btn btn-light btn-lg px-5 py-3 fw-bold rounded-pill shadow-lg transition-all"
                                    style="color: var(--primary);">Share Your Story</a>
                                <% } %>
                                    <a href="#read-blogs"
                                        class="btn btn-outline-light btn-lg px-5 py-3 fw-bold rounded-pill backdrop-blur transition-all">Explore
                                        Blogs</a>
                    </div>
                </div>
            </div>

            <!-- Real Stats Support Section -->
            <div class="container animate-fade-up" style="margin-top: -60px; position: relative; z-index: 10;">
                <div class="glass-card rounded-4 p-4 shadow-lg">
                    <div class="row text-center align-items-center">
                        <div class="col-md-4 border-end border-light-subtle">
                            <div class="stats-counter">
                                <%= stats.users %>+
                            </div>
                            <div class="stats-label">Active Travelers</div>
                        </div>
                        <div class="col-md-4 border-end border-light-subtle">
                            <div class="stats-counter">
                                <%= stats.blogs %>+
                            </div>
                            <div class="stats-label">Stories Shared</div>
                        </div>
                        <div class="col-md-4">
                            <div class="stats-counter">
                                <%= stats.countries %>+
                            </div>
                            <div class="stats-label">Destinations</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Prime Features Section -->
            <div class="feature-section py-5 my-5">
                <div class="container">
                    <div class="text-center mb-5 animate-fade-up">
                        <h2 class="section-title h1">Elevate Your Experience</h2>
                        <div class="section-divider mt-3"></div>
                        <p class="text-secondary mx-auto lead" style="max-width: 600px;">
                            Powerful tools designed for the modern-day explorer.
                        </p>
                    </div>

                    <div class="row g-4 justify-content-center">
                        <!-- Travel Blogs -->
                        <div class="col-md-6 col-lg-3 animate-fade-up" style="animation-delay: 0.1s;">
                            <div class="feature-card glass-card">
                                <div class="feature-icon-wrapper shadow-sm">
                                    <i data-lucide="book-open" style="width: 32px; height: 32px;"></i>
                                </div>
                                <h4 class="fw-bold mb-3">Travel Stories</h4>
                                <p class="text-secondary small mb-4">
                                    Capture every moment with our rich text editor and multi-media support.
                                </p>
                                <a href="#read-blogs"
                                    class="btn btn-primary btn-sm px-4 rounded-pill mt-auto">Explore</a>
                            </div>
                        </div>

                        <!-- Connect Socially -->
                        <div class="col-md-6 col-lg-3 animate-fade-up" style="animation-delay: 0.2s;">
                            <div class="feature-card glass-card">
                                <div class="feature-icon-wrapper shadow-sm">
                                    <i data-lucide="users" style="width: 32px; height: 32px;"></i>
                                </div>
                                <h4 class="fw-bold mb-3">Connect Social</h4>
                                <p class="text-secondary small mb-4">
                                    Follow fellow travelers, build your profile, and grow your audience globally.
                                </p>
                                <a href="/social/search" class="btn btn-primary btn-sm px-4 rounded-pill mt-auto">Find
                                    People</a>
                            </div>
                        </div>

                        <!-- AI Assistant -->
                        <div class="col-md-6 col-lg-3 animate-fade-up" style="animation-delay: 0.3s;">
                            <div class="feature-card glass-card">
                                <div class="feature-icon-wrapper shadow-sm">
                                    <i data-lucide="sparkles" style="width: 32px; height: 32px;"></i>
                                </div>
                                <h4 class="fw-bold mb-3">AI Assistant</h4>
                                <p class="text-secondary small mb-4">
                                    Your personal co-pilot for trip planning, logistics, and local tips.
                                </p>
                                <button class="btn btn-primary btn-sm px-4 rounded-pill mt-auto"
                                    onclick="document.getElementById('botToggleBtn').click()">Ask AI</button>
                            </div>
                        </div>

                        <!-- Real-time Chat -->
                        <div class="col-md-6 col-lg-3 animate-fade-up" style="animation-delay: 0.4s;">
                            <div class="feature-card glass-card">
                                <div class="feature-icon-wrapper shadow-sm">
                                    <i data-lucide="zap" style="width: 32px; height: 32px;"></i>
                                </div>
                                <h4 class="fw-bold mb-3">Instant Chat</h4>
                                <p class="text-secondary small mb-4">
                                    Real-time messaging to collaborate on trips or just stay in touch.
                                </p>
                                <a href="/chat" class="btn btn-primary btn-sm px-4 rounded-pill mt-auto">Join Chat</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="read-blogs" class="container pt-5 pb-5 mt-4" style="max-width: var(--container-max);">
                <div class="text-center mb-5">
                    <h2 class="section-title">Read Our Latest Blogs</h2>
                    <div class="section-divider"></div>
                </div>

                <!-- Categories Section -->
                <div class="row mb-5">
                    <div class="col-12">
                        <div class="category-tabs d-flex justify-content-center">
                            <ul class="nav nav-pills mb-4 d-flex flex-wrap justify-content-center gap-2" id="pills-tab"
                                role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active" id="pills-all-tab" data-bs-toggle="pill"
                                        data-bs-target="#pills-all" type="button" role="tab" aria-controls="pills-all"
                                        aria-selected="true">All Posts</button>
                                </li>
                                <% Object.keys(blogsByCategory).forEach(function(category, index) { %>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link" id="pills-<%= category.toLowerCase() %>-tab"
                                            data-bs-toggle="pill" data-bs-target="#pills-<%= category.toLowerCase() %>"
                                            type="button" role="tab" aria-controls="pills-<%= category.toLowerCase() %>"
                                            aria-selected="false">
                                            <%= category %>
                                        </button>
                                    </li>
                                    <% }); %>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Blogs Section -->
                <div class="tab-content" id="pills-tabContent">
                    <!-- All Blogs Tab -->
                    <div class="tab-pane fade show active" id="pills-all" role="tabpanel"
                        aria-labelledby="pills-all-tab">
                        <div class="row g-4"> <!-- g-4 adds gap between columns -->
                            <% let allBlogs=[]; %>
                                <% Object.values(blogsByCategory).forEach(blogs=> { allBlogs = allBlogs.concat(blogs);
                                    }); %>

                                    <% if (allBlogs.length===0) { %>
                                        <div class="col-12 text-center py-5">
                                            <div class="empty-state">
                                                <i data-lucide="newspaper" class="mb-3 opacity-25"
                                                    style="width: 48px; height: 48px;"></i>
                                                <h3>No blogs yet</h3>
                                                <p class="mb-4">Be the first to share your thoughts with the community!
                                                </p>
                                                <% if (locals.user) { %>
                                                    <a href="/blog/add-new" class="btn btn-primary">Create Your First
                                                        Blog</a>
                                                    <% } else { %>
                                                        <a href="/user/signin" class="btn btn-primary">Sign In to Start
                                                            Blogging</a>
                                                        <% } %>
                                            </div>
                                        </div>
                                        <% } else { %>
                                            <% allBlogs.sort((a, b)=> new Date(b.createdAt) - new
                                                Date(a.createdAt)).forEach(function(blog) { %>
                                                <div class="col-12 col-md-6 col-lg-4 animate-fade-up">
                                                    <div class="card h-100 blog-card border-0">
                                                        <div class="blog-card-img-wrapper">
                                                            <div class="blog-card-badge"
                                                                style="background-color: <%= categoryColors[blog.category] || '#6c757d' %>; color: white;">
                                                                <%= blog.category %>
                                                            </div>
                                                            <img src="<%= blog.coverImageURL %>" alt="<%= blog.title %>"
                                                                onerror="this.src='/images/default.png'">
                                                            <div class="blog-card-overlay"></div>
                                                        </div>

                                                        <div class="blog-card-content">
                                                            <h5 class="blog-card-title mb-0">
                                                                <a href="/blog/<%= blog._id %>"
                                                                    class="text-decoration-none text-reset stretched-link">
                                                                    <%= blog.title %>
                                                                </a>
                                                            </h5>
                                                        </div>

                                                        <div class="blog-card-footer">
                                                            <a href="/profile/<%= blog.createdBy._id %>"
                                                                class="blog-card-author position-relative z-1">
                                                                <img src="<%= blog.createdBy.profileImageURL || '/images/default.png' %>"
                                                                    alt="<%= blog.createdBy.fullName %>"
                                                                    onerror="this.src='/images/default.png'">
                                                                <span class="small fw-semibold">
                                                                    <%= blog.createdBy.fullName %>
                                                                </span>
                                                            </a>
                                                            <div class="blog-card-stats">
                                                                <div class="blog-card-stats-item">
                                                                    <i data-lucide="heart"
                                                                        style="width: 14px; height: 14px;"></i>
                                                                    <span>
                                                                        <%= blog.likes ? blog.likes.length : 0 %>
                                                                    </span>
                                                                </div>
                                                                <div class="blog-card-stats-item">
                                                                    <i data-lucide="message-square"
                                                                        style="width: 14px; height: 14px;"></i>
                                                                    <span>
                                                                        <%= typeof blog.comments !=='undefined' ?
                                                                            blog.comments.length : 0 %>
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }); %>
                                                    <% } %>
                        </div>
                    </div>

                    <!-- Category Tabs -->
                    <% Object.keys(blogsByCategory).forEach(function(category) { %>
                        <div class="tab-pane fade" id="pills-<%= category.toLowerCase() %>" role="tabpanel"
                            aria-labelledby="pills-<%= category.toLowerCase() %>-tab">
                            <div class="row">
                                <% if (blogsByCategory[category].length===0) { %>
                                    <div class="col-12 text-center py-5">
                                        <div class="empty-state">
                                            <i class="fas fa-folder-open fa-4x mb-3 text-tertiary"></i>
                                            <h3>No <%= category %> blogs yet</h3>
                                            <p class="mb-4">Be the first to write about <%= category %>!</p>
                                            <% if (locals.user) { %>
                                                <a href="/blog/add-new" class="btn btn-primary">Write a <%= category %>
                                                        Blog</a>
                                                <% } else { %>
                                                    <a href="/user/signin" class="btn btn-primary">Sign In to Start
                                                        Blogging</a>
                                                    <% } %>
                                        </div>
                                    </div>
                                    <% } else { %>
                                        <% blogsByCategory[category].sort((a, b)=> new Date(b.createdAt) - new
                                            Date(a.createdAt)).forEach(function(blog) { %>
                                            <div class="col-12 col-md-6 col-lg-4 animate-fade-up">
                                                <div class="card h-100 blog-card border-0">
                                                    <div class="blog-card-img-wrapper">
                                                        <div class="blog-card-badge"
                                                            style="background-color: <%= categoryColors[blog.category] || '#6c757d' %>; color: white;">
                                                            <%= blog.category %>
                                                        </div>
                                                        <img src="<%= blog.coverImageURL %>" alt="<%= blog.title %>"
                                                            onerror="this.src='/images/default.png'">
                                                        <div class="blog-card-overlay"></div>
                                                    </div>

                                                    <div class="blog-card-content">
                                                        <h5 class="blog-card-title mb-0">
                                                            <a href="/blog/<%= blog._id %>"
                                                                class="text-decoration-none text-reset stretched-link">
                                                                <%= blog.title %>
                                                            </a>
                                                        </h5>
                                                    </div>

                                                    <div class="blog-card-footer">
                                                        <a href="/profile/<%= blog.createdBy._id %>"
                                                            class="blog-card-author position-relative z-1">
                                                            <img src="<%= blog.createdBy.profileImageURL || '/images/default.png' %>"
                                                                alt="<%= blog.createdBy.fullName %>"
                                                                onerror="this.src='/images/default.png'">
                                                            <span class="small fw-semibold">
                                                                <%= blog.createdBy.fullName %>
                                                            </span>
                                                        </a>
                                                        <div class="blog-card-stats">
                                                            <div class="blog-card-stats-item">
                                                                <i data-lucide="heart"
                                                                    style="width: 14px; height: 14px;"></i>
                                                                <span>
                                                                    <%= blog.likes ? blog.likes.length : 0 %>
                                                                </span>
                                                            </div>
                                                            <div class="blog-card-stats-item">
                                                                <i data-lucide="message-square"
                                                                    style="width: 14px; height: 14px;"></i>
                                                                <span>
                                                                    <%= typeof blog.comments !=='undefined' ?
                                                                        blog.comments.length : 0 %>
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }); %>
                                                <% } %>
                            </div>
                        </div>
                        <% }); %>
                </div>
            </div>

            <%- include('partials/footer') %>
                <%- include('partials/scripts') %>
</body>

</html>