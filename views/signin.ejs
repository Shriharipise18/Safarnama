<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <title>Sign In</title>

</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/nav') %>
            <div class="container mt-5">
                <div class="row justify-content-center">
                    <div class="col-md-6">
                        <div class="card shadow">
                            <div class="card-body">
                                <h2 class="card-title text-center mb-4">Sign In</h2>

                                <% if (locals.error) { %>
                                    <div class="alert alert-danger d-flex align-items-center">
                                        <% if (locals.error==="Incorrect Email or Password" ) { %>
                                            <i data-lucide="exclamation-circle" class="me-2 icon-sm"></i> The email or
                                            password you
                                            entered is incorrect. Please try again.
                                            <% } else if (locals.error.includes("GitHub authentication")) { %>
                                                <i data-lucide="alert-triangle" class="me-2 icon-sm"></i>
                                                <%= locals.error %>
                                                    <% } else { %>
                                                        <i data-lucide="exclamation-circle" class="me-2 icon-sm"></i>
                                                        <%= locals.error %>
                                                            <% } %>
                                    </div>
                                    <% } else if (locals.query && locals.query.error) { %>
                                        <div class="alert alert-danger d-flex align-items-center">
                                            <% if (locals.query.error==="github_auth_unavailable" ) { %>
                                                <i data-lucide="alert-triangle" class="me-2 icon-sm"></i> GitHub
                                                authentication
                                                is not available. Please sign in with email and password.
                                                <% } else if (locals.query.error==="auth_failed" ) { %>
                                                    <i data-lucide="exclamation-circle" class="me-2 icon-sm"></i>
                                                    Authentication
                                                    failed. Please try again.
                                                    <% } else { %>
                                                        <i data-lucide="exclamation-circle" class="me-2 icon-sm"></i> An
                                                        error
                                                        occurred. Please try again.
                                                        <% } %>
                                        </div>
                                        <% } %>

                                            <form action="/user/signin" method="post">
                                                <div class="mb-3">
                                                    <label for="email" class="form-label">Email</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text"><i data-lucide="mail"
                                                                class="icon-md"></i></span>
                                                        <input type="email" class="form-control" name="email" id="email"
                                                            placeholder="name@example.com" required>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="password" class="form-label">Password</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text"><i data-lucide="lock"
                                                                class="icon-md"></i></span>
                                                        <input type="password" class="form-control" name="password"
                                                            id="password" placeholder="Password" required>
                                                    </div>
                                                </div>
                                                <div class="d-grid gap-2">
                                                    <button type="submit" class="btn btn-primary">
                                                        <i data-lucide="log-in" class="icon-md"></i> Sign In
                                                    </button>
                                                </div>
                                            </form>

                                            <div class="mt-4 text-center">
                                                <p class="text-muted mb-3">Or sign in with:</p>
                                                <a href="/user/auth/github"
                                                    class="btn btn-outline-dark w-100 mb-2 d-flex align-items-center justify-content-center">
                                                    <i data-lucide="github" class="me-2 icon-md"></i>
                                                    Sign in with GitHub
                                                </a>
                                            </div>

                                            <div class="mt-4 text-center">
                                                <p class="mb-0">Don't have an account? <a href="/user/signup">Sign
                                                        Up</a></p>
                                            </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <%- include('partials/footer') %>
                <%- include('partials/scripts') %>

</body>

</html>